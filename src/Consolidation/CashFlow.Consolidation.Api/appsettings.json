{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Database": {
    "Provider": "Postgres",
    "ConnectionString": "Host=localhost;Port=5432;Database=cashflow_consolidation;Username=cashflow;Password=cashflow",
    "ApplySchemaOnStartup": true,
    "MaxRetryCount": 5,
    "CommandTimeoutSeconds": 30
  },
  "Messaging": {
    "Provider": "RabbitMq",
    "RabbitMq": {
      "HostName": "localhost",
      "Port": 5672,
      "UserName": "cashflow",
      "Password": "cashflow",
      "VirtualHost": "/",
      "Exchange": "cashflow.events",
      "DeadLetterExchange": "cashflow.events.dlx",
      "QueueName": "cashflow.consolidation",
      "ClientProvidedName": "cashflow-consolidation-api",
      "PrefetchCount": 64,
      "ConsumerConcurrency": 8,
      "MaxProcessingAttempts": 3,
      "RetryBaseDelayMilliseconds": 200
    }
  }
}
